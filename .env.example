# ── 必须 ──────────────────────────────────────────────────────────────────
# DeepSeek API Key（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-key-here

# ── LangFuse 可观测性（可选，不配则自动跳过所有追踪）──────────────────────
# 从 https://cloud.langfuse.com 获取
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Qdrant 远程连接（可选，Docker 部署时自动设为 http://qdrant:6333）─────
# 本地开发默认用文件存储（./storage/qdrant），无需设置
QDRANT_URL=
MEM0_QDRANT_URL=

# ── Mem0 存储路径（可选，Docker 部署时自动设为 /app/storage/mem0_history.db）─
MEM0_HISTORY_DB=

# ── 调试模式 ──────────────────────────────────────────────────────────────
# 设为 1 时每轮 ReAct 迭代打印完整消息历史
DEBUG=0
